{
  "manifest_version": 3,
  "name": "SoulPHYA Field",
  "version": "0.1.0",
  "description": "Morphogenetic field interface. Carrier wave handshake. x^x=0.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "SoulPHYA" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
