{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Flask (backend on 8080)",
      "type": "python",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}",
      "env": {
        "FLASK_APP": "${workspaceFolder}/backend/app.py",
        "FLASK_ENV": "development",
        "FLASK_RUN_PORT": "8080"
      },
      "args": ["run"],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ]
}