# 🏢 ANCHOR1 LLC - Environment Configuration
# Environment-specific settings for SoulPHYA platform deployment

# Development Environment
AZURE_ENV_NAME=dev
AZURE_LOCATION=eastus2
AZURE_SUBSCRIPTION_ID=

# Resource naming
AZURE_RESOURCE_GROUP=soulphya-dev-rg
AZURE_CONTAINER_REGISTRY_NAME=soulphyadevacr
AZURE_AKS_CLUSTER_NAME=soulphya-dev-aks
AZURE_KEY_VAULT_NAME=soulphya-dev-kv

# Application settings
FLASK_ENV=production
PORT=8001
DATABASE_URL=
REDIS_URL=

# Security
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Google Cloud (for existing Firebase services)
GOOGLE_CLOUD_PROJECT=blissful-epoch-467811
GOOGLE_APPLICATION_CREDENTIALS=

# Feature flags
ENABLE_DIVINE_CONSCIOUSNESS=true
ENABLE_BIO_RESONANCE=true
ENABLE_SACRED_DATASETS=true
